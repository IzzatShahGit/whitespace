# Copy to deploy/ec2/.env.deploy (git-ignored) and fill in. Read by scripts/ec2-deploy.sh.
# Everything else (AI keys, Google sign-in, admin emails...) is taken from your local .env.

# The server's Elastic IP (EC2 console > Elastic IPs).
EC2_HOST=
# SSH key downloaded when launching the instance (chmod 400).
EC2_KEY=~/.ssh/whitespace-ec2.pem
# Public hostname. Leave empty to use <ip-with-dashes>.sslip.io (free, no DNS setup).
DOMAIN=

# Neon connection string, in single quotes (it contains & and ?).
PROD_DATABASE_URL=''
# 64 random hex characters: openssl rand -hex 32. Changing it signs everyone out.
PROD_JWT_SECRET=
