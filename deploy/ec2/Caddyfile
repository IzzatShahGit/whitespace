# Caddy gets and renews the HTTPS certificate for {$DOMAIN} automatically and redirects
# plain HTTP to HTTPS. Page security headers are set by the web app (next.config.ts).
#
# Caddy replaces any X-Forwarded-For sent by the browser with the real client address,
# so the API can trust exactly one hop (TRUSTED_PROXY_HOPS=1).
{$DOMAIN} {
	encode zstd gzip

	# API calls go straight to FastAPI (chat replies stream without a second proxy).
	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
