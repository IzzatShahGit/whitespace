# Copy to .env and fill in. .env is gitignored; never commit real keys.

# ---------- Host ports (chosen to avoid other local projects) ----------
WEB_PORT=3400
API_PORT=8400
DB_PORT=5440
OLLAMA_PORT=11444

# ---------- App ----------
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3400

# ---------- Database ----------
# Running the API outside Docker (uv run whitespace-api) uses this.
# Inside Docker Compose it is overridden to point at the db container.
DATABASE_URL=postgresql+asyncpg://whitespace:whitespace@localhost:5440/whitespace

# ---------- Auth ----------
# Signs access tokens. Required (32+ random chars) outside local. Generate: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Must be true whenever the site runs over HTTPS (staging/production).
COOKIE_SECURE=false
# Public address of the web app (Google redirects back here).
PUBLIC_APP_URL=http://localhost:3400

# Google sign-in (optional; the button only shows when both are set).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
#   Authorized JavaScript origin: http://localhost:3400
#   Authorized redirect URI:      http://localhost:3400/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- LLM ----------
# gemini | groq | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_SMALL_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_SMALL_MODEL=openai/gpt-oss-20b
# Keys rotate round robin per request; a rate-limited key rests, the next one is used.
# Add as many as you have: _1, _2, _3 ... (a plain GOOGLE_API_KEY also works).
# Google AI Studio: https://aistudio.google.com
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
# Groq (fallback provider): https://console.groq.com
GROQ_API_KEY_1=
GROQ_API_KEY_2=
# Keys of the main provider tried per request before falling back; rest time after a 429
LLM_KEYS_PER_REQUEST=2
LLM_KEY_REST_SECONDS=60
# Ollama: LOCAL DEVELOPMENT ONLY (the API refuses it when APP_ENV is staging/production).
# Keep to small models (~3B, ~2 GB disk). Avoid 7B+ on this laptop: slow on CPU and big on disk.
# Good choices: qwen2.5:3b (default), llama3.2:3b, qwen2.5:1.5b (fastest)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11444

# ---------- Frontend ----------
# Where the Next.js server forwards /api/* (the browser only ever talks to the web app,
# so auth cookies stay first-party). Used at build time.
API_INTERNAL_URL=http://localhost:8400

# ---------- Trade data ----------
# US Census monthly imports: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# ---------- Web research (AI brief: "what's driving this") ----------
# Tavily: https://tavily.com (1,000 searches/month free, no card)
TAVILY_API_KEY=

# ---------- Later ----------
# REDIS_URL=
# HF_TOKEN=
